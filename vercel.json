{
  "version": 2,
  "builds": [
    {
      "src": "index.html",
      "use": "@vercel/static"
    },
    {
      "src": "pricing/package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist"
      }
    }
  ],
  "routes": [
    {
      "src": "/pricing/?$",
      "dest": "/pricing/dist/index.html"
    },
    {
      "src": "/pricing/(.*)",
      "dest": "/pricing/dist/$1"
    }
  ]
}
