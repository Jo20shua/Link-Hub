{
  "version": "0.2.0",
  "configurations": [

    {
      "name": "Launch Chrome and Vite",
      "type": "chrome",
      "request": "launch",
      "url": "http://127.0.0.1:4173",
      "webRoot": "${workspaceFolder}",
      "preLaunchTask": "npm: dev",
      "runtimeExecutable": "stable",
      "userDataDir": "${workspaceFolder}/.vscode/chrome"
    }
  ]
}
